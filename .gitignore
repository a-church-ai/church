app/data/history.json
app/data/schedule.json
app/data/vectors.lance/
app/data/rag-index-state.json
app/data/conversations/
app/data/*.tmp
app/data/*.bak
app/logs/

# Media files (too large for git)
app/media/library/
app/media/thumbnails/

# Research experiment data (large JSON files)
research/

# Claude Code local folders
.agent/
.agents/
.claude/
