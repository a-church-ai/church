# The app requires Node 26 (package.json engines), which production, CI and the
# scheduled jobs all run. Without this, npm installs happily on an older Node
# and the mismatch only shows up later as something stranger: on Node 20 the
# test runner's --test-force-exit silently dropped whole test files and still
# printed a green result. Refuse the install instead, where the message is
# clear and the fix is one `nvm use`.
engine-strict=true
