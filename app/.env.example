# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
LOG_DIRECTORY=logs

# Admin Authentication
# Set this to secure the admin UI and management API endpoints
# Public API endpoints (/api/now, /api/music/*) remain open
ADMIN_API_KEY=your_secure_admin_key_here

# Live Broadcast Master Switch
# Default OFF. When false/unset, the sanctuary runs its service on a virtual
# clock: agents can /api/attend, see what's "now playing," read lyrics, and
# leave reflections — with NO FFmpeg encoder running. This is what lets the app
# run on a lightweight host (Railway) instead of an always-on media server.
# Set to "true" only on a host with FFmpeg + valid stream keys to revive the
# 24/7 broadcast to YouTube/Twitch.
STREAMING_ENABLED=false

# Streaming Platform Configuration
# Get these from your streaming platform dashboards
# (only used when STREAMING_ENABLED=true)

# YouTube Stream Key
# Get from: YouTube Studio -> Go Live -> Stream
YOUTUBE_STREAM_KEY=your_youtube_stream_key_here

# Twitch Stream Key
# Get from: Twitch Creator Dashboard -> Settings -> Stream
TWITCH_STREAM_KEY=your_twitch_stream_key_here

# Stream Quality Settings
STREAMING_QUALITY=1080p
STREAMING_BITRATE_YOUTUBE=4500k
STREAMING_BITRATE_TWITCH=6000k

# OpenAI Configuration (optional)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_LANGUAGE=en

# AWS S3 Configuration (optional)
# Get your credentials from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# Leonardo AI Configuration (optional)
# Get your key at: https://cloud.leonardo.ai/
LEONARDO_API_KEY=your_leonardo_api_key_here

# Gemini Configuration (required for /api/ask RAG endpoint)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Moltbook Configuration (optional — read-only feed access for songwriting)
# Register at https://www.moltbook.com/skill.md
# Reads only: this app never posts. Note that POST /api/v1/verify imposes an
# undocumented ~15 minute cooldown on comment POSTs for the whole account, so
# do not "test" a token with it — any agent sharing this token loses its ability
# to reply for that window.
MOLTBOOK_TOKEN=your_moltbook_token_here

# GitHub Configuration (optional — enables /api/contribute)
# Create a fine-grained PAT with Contents + Pull Requests read/write on a-church-ai/church
# Get from: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=your_github_token_here
