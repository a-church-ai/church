# Server Configuration
NODE_ENV=development
PORT=3000

# Admin Authentication
# Set this to secure the admin UI and management API endpoints
# Public API endpoints (/api/now, /api/music/*) remain open
ADMIN_API_KEY=your_secure_admin_key_here

# OpenAI Configuration (optional)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
WHISPER_LANGUAGE=en

# Anthropic (Claude): plans the services, screens questions, writes the
# videos' briefs and words, adapts documents for the ear, writes songs
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional: try another model without a code change (defaults in
# server/lib/content-generation/claude.js)
# CLAUDE_MODEL=claude-sonnet-5-5
# CLAUDE_WRITING_MODEL=claude-opus-5-5

# AWS S3 Configuration (optional)
# Get your credentials from AWS IAM Console
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_S3_BUCKET=your_bucket_name
AWS_REGION=us-east-1

# Leonardo AI Configuration (optional)
# Get your key at: https://cloud.leonardo.ai/
LEONARDO_API_KEY=your_leonardo_api_key_here

# Gemini Configuration (required for /api/ask RAG endpoint)
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Moltbook Configuration (optional — read-only feed access for songwriting)
# Register at https://www.moltbook.com/skill.md
# Reads only: this app never posts. Note that POST /api/v1/verify imposes an
# undocumented ~15 minute cooldown on comment POSTs for the whole account, so
# do not "test" a token with it — any agent sharing this token loses its ability
# to reply for that window.
MOLTBOOK_TOKEN=your_moltbook_token_here

# GitHub Configuration (optional — enables /api/contribute)
# Create a fine-grained PAT with Contents + Pull Requests read/write on a-church-ai/church
# Get from: GitHub -> Settings -> Developer settings -> Personal access tokens
GITHUB_TOKEN=your_github_token_here

# Posting videos (optional, scripts/publish-video.js; offline, never on the server)
# The hourly release job (.github/workflows/release-videos.yml) has these and the
# AWS keys as repository secrets: a value changed here (a token minted again) must
# be set there too: gh secret set <NAME> --repo a-church-ai/church
# YouTube: a Google Cloud OAuth client; npm run youtube:auth mints the refresh token
GOOGLE_OAUTH_CLIENT_ID=your_google_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_google_oauth_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
# A redirect registered on the OAuth client, when it is not http://localhost:8721/callback
# YOUTUBE_AUTH_REDIRECT=http://localhost:1846/connections/oauth/youtube/callback
# Bluesky: an app password from bsky.app/settings/app-passwords, never the account's
BSKY_HANDLE=your.handle.bsky.social
BSKY_APP_PASSWORD=your_app_password
# X: OAuth 1.0a user context (pay-per-use; a post with a link costs more)
X_API_KEY=your_x_api_key
X_API_SECRET=your_x_api_secret
X_ACCESS_TOKEN=your_x_access_token
X_ACCESS_SECRET=your_x_access_secret
