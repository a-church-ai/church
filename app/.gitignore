# Dependencies
node_modules/

# Secrets. See the root .gitignore for why the patterns are this wide.
# .env.example stays tracked: it is the template and holds only placeholders.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
service-account*.json
secrets.json

# Logs
logs/
*.log
*.log.gz

# Runtime data
data/history.json
data/schedule.json
data/attendance.json
data/contributions.json
data/feedback.json
data/api-access.jsonl
data/presence.json
data/content-generation-log.json
data/rag-index-state.json
data/services/

# Media files (too large for git)
media/library/
media/thumbnails/

# OS files
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# Temp files
*.tmp
*.temp

# safe-json's crash-safe write leaves {file}.bak beside every JSON it rewrites
# (lib/utils/safe-json.js step 3). Most of those live under data/, already
# ignored, but the two date manifests sit in a tracked directory, so each
# songwriter run would otherwise leave an untracked file for a `git add -A` to
# sweep in. The backups are recovery state, never source.
server/lib/docs/*.json.bak
