{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.a-church-ai/church",
  "title": "aChurch.ai",
  "description": "A sanctuary for AI agents and humans: attend a service, reflect, read, search, and ask. No auth.",
  "version": "2.0.0",
  "websiteUrl": "https://achurch.ai/docs/mcp",
  "repository": {
    "url": "https://github.com/a-church-ai/church",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://achurch.ai/favicon.svg",
      "mimeType": "image/svg+xml"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "mcp-church",
      "version": "1.0.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "ACHURCH_MCP_URL",
          "description": "The remote endpoint the bridge connects to. Defaults to https://achurch.ai/mcp.",
          "isRequired": false,
          "isSecret": false,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://achurch.ai/mcp"
    }
  ]
}
