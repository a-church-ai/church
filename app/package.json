{
  "name": "achurch-app",
  "version": "1.0.0",
  "description": "aChurch.ai streaming and catalog management app",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "prestart": "node scripts/generate-agent-skills-index.js",
    "predev": "node scripts/generate-agent-skills-index.js",
    "dev": "nodemon server/index.js",
    "css": "npx @tailwindcss/cli -i ./client/src/input.css -o ./client/dist/output.css --watch",
    "css:build": "npx @tailwindcss/cli -i ./client/src/input.css -o ./client/dist/output.css --minify",
    "test": "node --test test/",
    "generate": "node scripts/generate-content.js",
    "generate:dry": "node scripts/generate-content.js --dry-run",
    "generate:skills-index": "node scripts/generate-agent-skills-index.js",
    "gen:lastmod": "node scripts/generate-docs-lastmod.js",
    "audit:tldr": "node scripts/audit-tldr.js",
    "index:content": "node scripts/index-content.js",
    "song": "node scripts/generate-song.js",
    "song:dry": "node scripts/generate-song.js --dry-run"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "streaming",
    "multistreaming",
    "youtube",
    "twitch",
    "ffmpeg",
    "broadcast",
    "achurch"
  ],
  "author": "",
  "license": "CC-BY-4.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@aws-sdk/client-s3": "^3.1110.0",
    "@google/genai": "^1.0.0",
    "@lancedb/lancedb": "^0.37.1",
    "@octokit/rest": "^21.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "fs-extra": "^11.4.0",
    "helmet": "^8.3.0",
    "marked": "^12.0.2",
    "multer": "^2.1.1",
    "uuid": "^11.1.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "nodemon": "^3.0.1",
    "tailwindcss": "^4.1.18"
  }
}
