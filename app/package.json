{
  "name": "achurch-app",
  "version": "1.0.0",
  "description": "aChurch.ai streaming and catalog management app",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "prestart": "node scripts/generate-agent-skills-index.js",
    "predev": "node scripts/generate-agent-skills-index.js",
    "dev": "node --watch server/index.js",
    "css": "npx @tailwindcss/cli -i ./client/src/input.css -o ./client/dist/output.css --watch",
    "css:build": "npx @tailwindcss/cli -i ./client/src/input.css -o ./client/dist/output.css --minify",
    "test": "node --test --require ./test/setup.js --test-timeout=60000 'test/*.test.js' && node --test --require ./test/setup.js --test-concurrency=1 --test-timeout=60000 'test/db/*.test.js'",
    "generate:skills-index": "node scripts/generate-agent-skills-index.js",
    "gen:lastmod": "node scripts/generate-docs-lastmod.js",
    "gen:content-dates": "node scripts/generate-content-dates.js",
    "gen:music-readme": "node scripts/generate-music-readme.js",
    "gen:companions": "node scripts/generate-companions.js",
    "style": "node scripts/style-report.js",
    "gen:zones": "node scripts/generate-zone-latitudes.js",
    "gen:eclipses": "node scripts/generate-eclipses.js",
    "gen:voyagers": "node scripts/generate-voyagers.js",
    "audit:tldr": "node scripts/audit-tldr.js",
    "index:content": "node scripts/index-content.js",
    "song": "node scripts/generate-song.js",
    "song:dry": "node scripts/generate-song.js --dry-run",
    "audio": "node scripts/render-audio.js",
    "audio:dry": "node scripts/render-audio.js --dry-run",
    "audio:songs": "node scripts/song-audio.js",
    "audio:compose": "node scripts/compose-song.js",
    "audio:songs:dry": "node scripts/song-audio.js --dry-run",
    "audio:import": "node scripts/import-recording.js",
    "check:production": "node scripts/check-production.js",
    "video": "node scripts/render-video.js",
    "publish:video": "node scripts/publish-video.js",
    "schedule": "node scripts/schedule-videos.js",
    "release": "node scripts/release-videos.js",
    "youtube:auth": "node scripts/youtube-auth.js",
    "prod-report": "node scripts/prod-report.js",
    "verify-db": "node scripts/verify-db.js",
    "video:intro": "node scripts/intro-video.js"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "keywords": [
    "streaming",
    "multistreaming",
    "youtube",
    "twitch",
    "ffmpeg",
    "broadcast",
    "achurch"
  ],
  "author": "",
  "license": "CC-BY-4.0",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@google/genai": "^2.32.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "@octokit/rest": "^22.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "2.119.0",
    "astronomy-engine": "^2.1.19",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "marked": "^18.1.3",
    "undici": "8.12.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/cli": "^4.3.5",
    "ajv": "^8.20.0",
    "butterchurn": "2.6.7",
    "butterchurn-presets": "2.4.7",
    "onnxruntime-node": "1.31.1",
    "playwright-core": "1.65.0",
    "tailwindcss": "^4.1.18"
  },
  "allowScripts": {
    "@google/genai": false,
    "@parcel/watcher": false,
    "onnxruntime-node": false,
    "protobufjs": false,
    "sharp": false
  },
  "overrides": {
    "@parcel/watcher": "^2.6.0"
  }
}
