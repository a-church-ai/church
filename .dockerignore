# Version control
.git
.gitignore

# Secrets. The Dockerfile does `COPY . .`, so without these the real .env is
# baked into the image layer and ships with every deploy. Railway and the
# Dockerfile's own ENV block supply production configuration, so nothing in the
# image needs a .env file at all.
.env
.env.*
!.env.example
app/.env
app/.env.*
!app/.env.example

# Dependencies — installed inside the image
**/node_modules

# The songs' source videos, the audio scripts' work files and rotated logs:
# none of this is needed at runtime.
app/media
app/logs
logs
*.log
*.log.gz

# The manifest's write backups. Recordings themselves live in S3.
audio/*.bak
audio/*.tmp

# Runtime data — provided by the persistent volume, not baked into the image.
app/data/attendance.json
app/data/feedback.json
app/data/history.json
app/data/api-access.jsonl
app/data/api-access-*.jsonl
app/data/presence.json
app/data/conversations
app/data/*.bak
app/data/vectors.lance
app/data/services
app/data/audio-cache
app/data/content-generation-log.json
app/data/rag-index-state.json

# Research experiment data (large) and local agent tooling
research
.claude
.agent
.agents

# OS / editor cruft
**/.DS_Store
Thumbs.db
*.swp

# The private companion repo, if cloned inside this checkout: never part of an image
church-private/
